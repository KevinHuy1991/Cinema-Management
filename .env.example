# ==============================================================================
# CINEMA MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Hướng dẫn:
# 1. Sao chép tệp này thành .env: `cp .env.example .env` (hoặc `copy .env.example .env` trên Windows).
# 2. Thay đổi các giá trị bí mật (JWT_SECRET, COOKIE_SECRET) sang chuỗi ngẫu nhiên mạnh trước khi chạy.
# 3. Tuyệt đối KHÔNG commit file .env chứa khóa thật lên Git repository!
# ==============================================================================

# Cổng mạng chạy Backend Web Server
PORT=8099

# Môi trường thực thi: 'development' | 'production' | 'test'
NODE_ENV=development

# Khóa bí mật ký số JSON Web Token (HMAC-SHA256)
# Khuyến nghị: Chuỗi ngẫu nhiên tối thiểu 32 ký tự (256-bit)
JWT_SECRET=cinema_secure_jwt_secret_key_production_super_strong_2026_xyz

# Thời hạn sống của JWT Token (2h ~ 4h theo yêu cầu bảo mật)
JWT_EXPIRES_IN=4h

# Khóa bí mật mã hóa / ký Cookie
COOKIE_SECRET=cinema_cookie_signature_secret_987654321

# Danh sách tên miền (Origins) được phép gọi API (phân cách bằng dấu phẩy)
ALLOWED_ORIGINS=http://localhost:8099,http://127.0.0.1:8099

